# Copy this file to .env and fill in your own keys.
# .env is gitignored-worthy — don't commit it anywhere.

NVIDIA_API_KEY=

# Optional — see README "Persistent storage" section. Without these,
# search logs and site settings still work but reset on every
# restart/redeploy (Render's free tier wipes local disk).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin dashboard — see README for how to generate ADMIN_PASSWORD_HASH
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
